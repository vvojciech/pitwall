#!/usr/bin/env python3
"""pitwall: watch and steer coding agents from iTerm2.

  pitwall install      add the agent hooks and start the daemon
  pitwall uninstall    remove the hooks and stop the daemon
  pitwall doctor       check the setup
  pitwall mission      open Mission Control
  pitwall hook AGENT EVENT   (run by Claude Code and Codex)
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))


def main(argv):
    command = argv[0] if argv else "help"
    if command == "hook" and len(argv) == 3:
        from pitwall.hook import run
        run(argv[1], argv[2])
        return 0
    if command in ("install", "uninstall", "doctor"):
        from pitwall import install
        result = getattr(install, command)()
        return 1 if result is False else 0
    if command == "mission":
        from pitwall import config
        from pitwall.hook import post
        daemon = config.read_daemon()
        if not daemon:
            print("The daemon is not running. Run: pitwall doctor")
            return 1
        post(daemon, "/api/mission", {})
        return 0
    print(__doc__.strip())
    return 0 if command in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
